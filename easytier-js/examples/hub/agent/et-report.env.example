ET_HUB_URL=https://et.example.com
ET_REPORT_TOKEN=替换成 openssl rand -hex 32 生成的值
ET_RPC=127.0.0.1:15888
# 每台机器必须唯一（reporter 是快照主键，重复会互相覆盖历史）；不填则取 hostname
# ET_REPORTER=node-1
ET_INTERVAL=120
# ET_CLI=/usr/local/bin/easytier-cli
# 可选：自报坐标。节点上报出网被代理/NAT 污染时必填（否则城市会按代理出口判错）
# ET_LAT=30.5928
# ET_LON=114.3055
# ET_CITY=Wuhan
# ET_COUNTRY=CN
# 可选：主域名偶发 TLS 抖动时自动回落的备用域（同一个 Worker）
# ET_HUB_FALLBACK=https://easytier-hub.ridesnail-6a2.workers.dev
# ET_TIMEOUT=25
